{
  "expo": {
    "name": "Domi",
    "slug": "domi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ellenwoconnor.domi",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ellenwoconnor.domi"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "domi",
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.681321857586-ia8edhlh1fj49f84deap0ti7er8ad16j"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "143c2f13-0e37-45a7-8f0a-21432b734733"
      }
    }
  }
}
