{
  "expo": {
    "name": "Domi",
    "slug": "domi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ellenwoconnor.domi",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:domicircles.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F4E79",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ellenwoconnor.domi",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "domicircles.com",
              "pathPrefix": "/c/"
            },
            {
              "scheme": "https",
              "host": "domicircles.com",
              "pathPrefix": "/i/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "domi",
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.681321857586-ia8edhlh1fj49f84deap0ti7er8ad16j"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Domi uses your photos so you can add pictures of things you're giving away.",
          "cameraPermission": "Domi uses the camera so you can photograph things you're giving away.",
          "microphonePermission": false
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "143c2f13-0e37-45a7-8f0a-21432b734733"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/143c2f13-0e37-45a7-8f0a-21432b734733"
    }
  }
}
