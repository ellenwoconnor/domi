  "name": "domi",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.96",
    "@convex-dev/react-query": "^0.1.0",
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@tanstack/react-query": "^5.104.3",
    "convex": "^1.47.0",
    "expo": "~57.0.30",
    "expo-apple-authentication": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.26",
    "jose": "^6.2.13",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "convex-test": "^0.0.62",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "dev:backend": "convex dev --run init",
    "typecheck": "tsc --noEmit && tsc -p convex --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:dev:ios": "npx eas-cli@latest build --profile development --platform ios",
    "setup:auth": "node scripts/setup-auth-keys.mjs",
    "test:web": "node --test web/src/index.test.mjs",
    "update:preview": "npx eas-cli@latest update --channel preview --environment preview --platform ios",
    "build:preview:ios": "npx eas-cli@latest build --profile preview --platform ios"
  },
  "private": true
}
