# Copy to .env.local, or just run `npm run dev:backend` once:
# `npx convex dev` creates the dev deployment and writes both values to .env.local.
# .env.local is gitignored. Never put secrets in EXPO_PUBLIC_* vars; they ship in the app.

# Which Convex deployment the CLI pushes functions to (set by `npx convex dev`)
CONVEX_DEPLOYMENT=

# Public URL the app connects to, e.g. https://happy-otter-123.convex.cloud
EXPO_PUBLIC_CONVEX_URL=

# Google OAuth client IDs from Google Cloud > Google Auth Platform > Clients.
# Public identifiers (not secrets). The web client's secret goes in Convex:
#   npx convex env set AUTH_GOOGLE_ID <web client id>
#   npx convex env set AUTH_GOOGLE_SECRET <web client secret>
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Development only: shows a test-account (email + password) form on the sign-in
# screen. Also needs `npx convex env set DEV_PASSWORD_AUTH true` on the dev
# deployment. Never set either for production builds.
EXPO_PUBLIC_DEV_PASSWORD_AUTH=
