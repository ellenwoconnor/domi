# Copy to .env.local, or just run `npm run dev:backend` once:
# `npx convex dev` creates the dev deployment and writes both values to .env.local.
# .env.local is gitignored. Never put secrets in EXPO_PUBLIC_* vars; they ship in the app.

# Which Convex deployment the CLI pushes functions to (set by `npx convex dev`)
CONVEX_DEPLOYMENT=

# Public URL the app connects to, e.g. https://happy-otter-123.convex.cloud
EXPO_PUBLIC_CONVEX_URL=
